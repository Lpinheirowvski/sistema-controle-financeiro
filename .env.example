# Copy to .env and replace both passwords before starting Docker Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-admin-password
DB_MIGRATION_PASSWORD=replace-with-a-different-migration-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=controle_financeiro
DB_USER=financial_app
DB_PASSWORD=replace-with-a-different-long-random-password
# Optional CA path for remote MySQL; enables certificate and hostname verification.
DB_SSL_CA=
LOG_LEVEL=INFO
BACKUP_DIR=backups
