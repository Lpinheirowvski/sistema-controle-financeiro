{
  "name": "Financial Analytics v2 · isolated development",
  "dockerComposeFile": ["../compose.yaml", "compose.dev.yaml"],
  "service": "dev",
  "runServices": ["db-test", "dev"],
  "workspaceFolder": "/app",
  "remoteUser": "app",
  "updateRemoteUserUID": true,
  "forwardPorts": [8501],
  "postCreateCommand": "python -m financial_analytics.cli init --seed && pytest -q",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {"python.defaultInterpreterPath": "/usr/local/bin/python"}
    }
  },
  "shutdownAction": "stopCompose"
}
